<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit res.config.settings — config_parameter handles ir.config_parameter
         storage automatically, no new res.company columns needed. -->
    <record id="view_ktx_expense_in_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ktx.expense</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Liquidaciones" name="ktx_expense_management">
                    <group>
                        <field name="ktx_allow_journal_entries"/>
                        <field name="ktx_multi_company_staging"/>
                    </group>
                    <div invisible="not ktx_multi_company_staging"
                         class="alert alert-info" role="alert">
                        <strong>Para que la Asignación Multiempresa funcione:</strong>
                        <ul class="mb-0">
                            <li>Active las empresas involucradas en su perfil de usuario
                                (ícono de empresa en la barra superior de Odoo).</li>
                            <li>En cada liquidación multiempresa, configure la Cuenta por Cobrar
                                Intercompañía y agregue la cuenta por pagar de cada empresa
                                en la pestaña «Intercompañía» de la liquidación.</li>
                        </ul>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Same XML id as before — menus.xml needs no change.
         Opens res.config.settings scrolled to the Liquidaciones section. -->
    <record id="action_server_ktx_expense_config" model="ir.actions.act_window">
        <field name="name">Configuración — Liquidaciones KTX</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ktx_expense_management'}</field>
    </record>

</odoo>
