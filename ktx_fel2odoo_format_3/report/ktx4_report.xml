<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1) Tamaño de papel: Carta, márgenes en 0. -->
    <record id="paperformat_ktx4_carta" model="report.paperformat">
        <field name="name">KTX4 - Carta</field>
        <field name="format">custom</field>
        <field name="page_height">279</field>
        <field name="page_width">216</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <!-- 2) Acción de reporte. El id externo DEBE ser action_report_ktx4_carta. -->
    <record id="action_report_ktx4_carta" model="ir.actions.report">
        <field name="name">Formato FEL GT (KTX4) - Carta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_fel2odoo_format_3.report_ktx4_carta</field>
        <field name="report_file">ktx_fel2odoo_format_3.report_ktx4_carta</field>
        <field name="print_report_name">'FEL_Formato_%s' % (object.name or object.id)</field>
        <field name="paperformat_id" ref="paperformat_ktx4_carta"/>
    </record>

    <!-- Media Carta: mismo diseño corporativo, en media hoja. Reutiliza la
         MISMA plantilla report_ktx4_carta (refluye al ancho menor). -->

    <record id="action_report_ktx4_media_carta" model="ir.actions.report">
        <field name="name">Formato FEL GT (KTX4) - Media Carta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_fel2odoo_format_3.report_ktx4_carta</field>
        <field name="report_file">ktx_fel2odoo_format_3.report_ktx4_carta</field>
        <field name="print_report_name">'FEL_Formato_%s' % (object.name or object.id)</field>
        <field name="paperformat_id" ref="paperformat_ktx4_carta"/>
    </record>

    <!-- Ticket (72mm termica): un diseño corporativo a color no aplica a una
         termica monocroma; se reutiliza la plantilla de ticket del modulo base
         (report_ktx1_ticket), una sola columna estilo POS. -->

    <!-- 3) Plantilla QWeb con el diseño KTX 4 (corporativo / carta). -->
    <template id="report_ktx4_carta">
        <t t-call="web.html_container">
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <t t-foreach="docs" t-as="o">
                <t t-set="dte" t-value="o._ktx_fel_get_format_data()"/>
                <t t-set="cfg" t-value="o._ktx_fel_format_company_data()"/>
                <t t-set="qr_src" t-value="o._ktx_fel_format_qr_img_src(dte['qr_url'])"/>
                <t t-set="accent" t-value="cfg['accent_color'] or '#16457a'"/>
                <t t-set="accent_text" t-value="cfg['accent_text'] or '#ffffff'"/>
                <t t-set="em" t-value="dte['emisor']"/>
                <t t-set="rc" t-value="dte['receptor']"/>
                <t t-set="cert" t-value="dte['certificacion']"/>

                <div class="ktx4">
                    <style>
                        .ktx4, .ktx4 * { font-family: Arial, Helvetica, sans-serif; box-sizing: border-box; }
                        .ktx4 { color:#20242b; font-size:11px; }
                        .ktx4 table { border-collapse: collapse; width:100%; }
                        .ktx4 .lbl { color:#97a0ae; font-weight:700; }
                        .ktx4 .muted { color:#5a6474; }
                    </style>

                    <!-- HEADER BAND -->
                    <table t-attf-style="background:{{accent}}; color:{{accent_text}};">
                        <tr>
                            <td style="padding:18px 12mm; vertical-align:middle; width:60%;">
                                <table style="width:auto;">
                                    <tr>
                                        <td t-if="cfg['logo']" style="vertical-align:middle; padding-right:14px;">
                                            <div style="background:#ffffff; border-radius:8px; padding:8px 12px;">
                                                <img t-att-src="image_data_uri(cfg['logo'])" style="max-height:40px; max-width:150px; object-fit:contain;"/>
                                            </div>
                                        </td>
                                        <td style="vertical-align:middle;">
                                            <div t-attf-style="font-size:15px; font-weight:800; color:{{accent_text}};">
                                                <t t-esc="em['nombre'] or em['nombre_comercial']"/>
                                            </div>
                                            <div t-attf-style="font-size:10px; color:{{accent_text}}; opacity:.82; margin-top:2px;">
                                                NIT <t t-esc="em['nit']"/>
                                                <t t-if="em['municipio']"> · <t t-esc="em['municipio']"/></t>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="padding:18px 12mm; vertical-align:middle; text-align:right;">
                                <div t-attf-style="font-size:8.5px; letter-spacing:2.2px; opacity:.75; font-weight:700; color:{{accent_text}};">DOCUMENTO TRIBUTARIO ELECTRÓNICO</div>
                                <div t-attf-style="font-size:21px; font-weight:800; line-height:1.05; margin-top:3px; color:{{accent_text}};">
                                    <t t-esc="dte['tipo_documento_label']"/>
                                </div>
                                <div t-attf-style="font-size:11px; opacity:.9; margin-top:4px; color:{{accent_text}};">
                                    Serie <t t-esc="cert['serie']"/> · No. <t t-esc="cert['numero']"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="padding:24px 12mm 30px;">

                        <!-- EMISOR / RECEPTOR -->
                        <table>
                            <tr>
                                <td style="width:50%; vertical-align:top; padding-right:8px;">
                                    <table style="border:1px solid #d3d9e2;">
                                        <tr><td style="background:#eef2f7; padding:6px 12px; font-size:9px; letter-spacing:1.6px; border-bottom:1px solid #d3d9e2;" class="muted"><strong>EMISOR</strong></td></tr>
                                        <tr><td style="padding:12px;">
                                            <div style="font-size:12px; font-weight:700;"><t t-esc="em['nombre']"/></div>
                                            <table style="margin-top:8px; font-size:10.5px;">
                                                <tr><td class="lbl" style="padding:2px 0; width:74px;">NIT</td><td style="font-weight:600;"><t t-esc="em['nit']"/></td></tr>
                                                <tr><td class="lbl" style="padding:2px 0; vertical-align:top;">Dirección</td><td class="muted"><t t-esc="em['direccion']"/><t t-if="em['municipio']">, <t t-esc="em['municipio']"/></t></td></tr>
                                                <tr t-if="cfg['social_phone']"><td class="lbl" style="padding:2px 0;">Teléfono</td><td class="muted"><t t-esc="cfg['social_phone']"/></td></tr>
                                                <tr><td class="lbl" style="padding:2px 0;">Correo</td><td class="muted"><t t-esc="cfg['social_email'] or em['correo']"/></td></tr>
                                            </table>
                                        </td></tr>
                                    </table>
                                </td>
                                <td style="width:50%; vertical-align:top; padding-left:8px;">
                                    <table style="border:1px solid #d3d9e2;">
                                        <tr><td style="background:#eef2f7; padding:6px 12px; font-size:9px; letter-spacing:1.6px; border-bottom:1px solid #d3d9e2;" class="muted"><strong>RECEPTOR</strong></td></tr>
                                        <tr><td style="padding:12px;">
                                            <div style="font-size:12px; font-weight:700;"><t t-esc="rc['nombre']"/></div>
                                            <table style="margin-top:8px; font-size:10.5px;">
                                                <tr><td class="lbl" style="padding:2px 0; width:74px;">NIT</td><td style="font-weight:600;"><t t-esc="rc['id']"/></td></tr>
                                                <tr><td class="lbl" style="padding:2px 0;">Dirección</td><td class="muted"><t t-esc="rc['direccion'] or 'Ciudad'"/></td></tr>
                                                <tr><td class="lbl" style="padding:2px 0;">Moneda</td><td style="font-weight:600;"><t t-esc="dte['moneda']"/></td></tr>
                                            </table>
                                        </td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- DOC DATA STRIP -->
                        <table style="border:1px solid #d3d9e2; border-top:none; margin-top:14px;">
                            <tr>
                                <td style="padding:8px 12px; border-right:1px solid #d3d9e2; width:55%;">
                                    <div class="lbl" style="font-size:8.5px; letter-spacing:1.2px;">NO. DE AUTORIZACIÓN</div>
                                    <div style="font-size:10.5px; font-weight:600; margin-top:2px; word-break:break-all;"><t t-esc="cert['uuid']"/></div>
                                </td>
                                <td style="padding:8px 12px; border-right:1px solid #d3d9e2;">
                                    <div class="lbl" style="font-size:8.5px; letter-spacing:1.2px;">FECHA EMISIÓN</div>
                                    <div style="font-size:10.5px; font-weight:600; margin-top:2px;"><t t-esc="dte['fecha_emision']"/></div>
                                </td>
                                <td style="padding:8px 12px;">
                                    <div class="lbl" style="font-size:8.5px; letter-spacing:1.2px;">FECHA CERTIFICACIÓN</div>
                                    <div style="font-size:10.5px; font-weight:600; margin-top:2px;"><t t-esc="cert['fecha']"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- ITEMS -->
                        <!-- Carta = area de lineas amplia (min-height); Media Carta = compacta. -->
                        <div t-attf-style="margin-top:18px; #{'min-height:80mm;' if cfg['paper_size'] == 'carta' else ''}">
                        <table t-attf-style="font-size:11px; border:1px solid {{accent}};">
                            <thead>
                                <tr t-attf-style="background:{{accent}}; color:{{accent_text}};">
                                    <th t-attf-style="text-align:center; padding:8px; font-size:9.5px; width:40px; color:{{accent_text}};">#</th>
                                    <th t-attf-style="text-align:center; padding:8px; font-size:9.5px; width:50px; color:{{accent_text}};">CANT.</th>
                                    <th t-attf-style="text-align:center; padding:8px; font-size:9.5px; width:54px; color:{{accent_text}};">U.M.</th>
                                    <th t-attf-style="text-align:left; padding:8px 12px; font-size:9.5px; color:{{accent_text}};">DESCRIPCIÓN</th>
                                    <th t-attf-style="text-align:right; padding:8px 12px; font-size:9.5px; width:92px; color:{{accent_text}};">P. UNIT.</th>
                                    <th t-attf-style="text-align:right; padding:8px 12px; font-size:9.5px; width:100px; color:{{accent_text}};">VALOR</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="dte['items']" t-as="it"
                                    t-attf-style="border-bottom:1px solid #e2e6ec; color:#20242b; {{'background:#f7f9fb;' if it_index % 2 else ''}}">
                                    <td style="text-align:center; padding:9px 8px; border-right:1px solid #eef1f5; vertical-align:top; color:#20242b;"><t t-esc="it['numero_linea']"/></td>
                                    <td style="text-align:center; padding:9px 8px; border-right:1px solid #eef1f5; vertical-align:top; color:#20242b;"><t t-esc="'%g' % it['cantidad']"/></td>
                                    <td style="text-align:center; padding:9px 8px; border-right:1px solid #eef1f5; vertical-align:top; color:#7a8494;"><t t-esc="it['unidad_medida'] or 'UNI'"/></td>
                                    <td style="padding:9px 12px; border-right:1px solid #eef1f5; vertical-align:top; line-height:1.5; color:#20242b;">
                                        <span style="font-weight:700;"><t t-esc="it['descripcion']"/></span>
                                    </td>
                                    <td style="text-align:right; padding:9px 12px; border-right:1px solid #eef1f5; vertical-align:top; color:#20242b;"><t t-esc="'%.2f' % it['precio_unitario']"/></td>
                                    <td style="text-align:right; padding:9px 12px; vertical-align:top; font-weight:600; color:#20242b;"><t t-esc="'%.2f' % it['total']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- BOTTOM -->
                        <table style="margin-top:18px;">
                            <tr>
                                <td style="width:56%; vertical-align:top; padding-right:12px;">
                                    <table style="border:1px solid #d3d9e2;">
                                        <tr><td style="background:#eef2f7; padding:6px 12px; font-size:9px; letter-spacing:1.4px; border-bottom:1px solid #d3d9e2;" class="muted"><strong>TOTAL EN LETRAS</strong></td></tr>
                                        <tr><td style="padding:10px 12px; font-size:11.5px; font-weight:700;"><t t-esc="dte['total_en_letras']"/></td></tr>
                                    </table>
                                    <div t-if="dte['frases']" style="margin-top:12px;">
                                        <t t-foreach="dte['frases']" t-as="fr">
                                            <span t-if="fr['texto']" t-attf-style="display:inline-block; font-size:9px; background:#eef2f7; color:{{accent}}; font-weight:700; padding:5px 9px; border:1px solid #d3d9e2; margin:0 5px 5px 0;">
                                                <t t-esc="fr['texto']"/>
                                            </span>
                                        </t>
                                    </div>
                                    <div t-if="cfg['show_footer'] and cfg['footer_description']" class="muted" style="margin-top:12px; font-size:10px; line-height:1.55;">
                                        <t t-esc="cfg['footer_description']"/>
                                    </div>
                                </td>
                                <td style="width:44%; vertical-align:top;">
                                    <table style="border:1px solid #d3d9e2;">
                                        <tr style="border-bottom:1px solid #e2e6ec;">
                                            <td class="muted" style="padding:9px 14px; font-size:11.5px;">Subtotal</td>
                                            <td style="padding:9px 14px; font-size:11.5px; text-align:right; font-weight:600; white-space:nowrap;"><t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % dte['gran_total']"/></td>
                                        </tr>
                                        <tr t-foreach="dte['total_impuestos']" t-as="imp" style="border-bottom:1px solid #e2e6ec;">
                                            <td class="muted" style="padding:9px 14px; font-size:11.5px;"><t t-esc="imp['nombre_corto']"/> (incluido)</td>
                                            <td style="padding:9px 14px; font-size:11.5px; text-align:right; font-weight:600; white-space:nowrap;"><t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % imp['monto']"/></td>
                                        </tr>
                                        <tr t-attf-style="background:{{accent}}; color:{{accent_text}};">
                                            <td t-attf-style="padding:12px 14px; font-size:10.5px; letter-spacing:0.8px; font-weight:700; color:{{accent_text}};">TOTAL A PAGAR</td>
                                            <td t-attf-style="padding:12px 14px; text-align:right; font-size:18px; font-weight:800; white-space:nowrap; color:{{accent_text}};"><t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % dte['gran_total']"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- CERTIFICACIÓN -->
                        <table style="margin-top:20px; border:1px solid #d3d9e2;">
                            <tr>
                                <td style="width:100px; padding:14px; border-right:1px solid #d3d9e2; vertical-align:middle; text-align:center;">
                                    <img t-if="qr_src" t-att-src="qr_src" style="width:80px; height:80px;"/>
                                </td>
                                <td style="padding:14px 16px; vertical-align:middle;">
                                    <div class="lbl" style="font-size:9px; letter-spacing:1.4px; margin-bottom:4px;">DATOS DE CERTIFICACIÓN</div>
                                    <div class="muted" style="font-size:10px; line-height:1.7;">
                                        <span style="color:#20242b; font-weight:700;">Certificador:</span> <t t-esc="cert['nombre_certificador']"/> · NIT <t t-esc="cert['nit_certificador']"/><br/>
                                        Autorización <t t-esc="cert['uuid']"/><br/>
                                        Certificado el <t t-esc="cert['fecha']"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
