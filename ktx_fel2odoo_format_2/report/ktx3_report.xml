<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1) Tamaño de papel: Carta, márgenes en 0 (el margen de lectura se hace
         con padding CSS, para que fondos/acentos lleguen al borde real). -->
    <record id="paperformat_ktx3_carta" model="report.paperformat">
        <field name="name">KTX3 - Carta</field>
        <field name="format">custom</field>
        <field name="page_height">279</field>
        <field name="page_width">216</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <!-- 2) Acción de reporte. El id externo DEBE ser action_report_ktx3_carta. -->
    <record id="action_report_ktx3_carta" model="ir.actions.report">
        <field name="name">Formato FEL GT (KTX3) - Carta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_fel2odoo_format_2.report_ktx3_carta</field>
        <field name="report_file">ktx_fel2odoo_format_2.report_ktx3_carta</field>
        <field name="print_report_name">'FEL_Formato_%s' % (object.name or object.id)</field>
        <field name="paperformat_id" ref="paperformat_ktx3_carta"/>
    </record>

    <!-- Media Carta: MISMA hoja fisica (carta) y MISMA plantilla; la
         diferencia real es que en Media Carta el area de lineas NO reserva
         espacio (compacta, solo las lineas), mientras que en Carta si reserva
         bastante espacio (formulario amplio). Esa diferencia la aplica la
         plantilla segun cfg['paper_size'] (ver el min-height de la tabla de
         items). No hay tamano Ticket en esta apariencia (solo en KTX 1). -->
    <record id="action_report_ktx3_media_carta" model="ir.actions.report">
        <field name="name">Formato FEL GT (KTX3) - Media Carta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_fel2odoo_format_2.report_ktx3_carta</field>
        <field name="report_file">ktx_fel2odoo_format_2.report_ktx3_carta</field>
        <field name="print_report_name">'FEL_Formato_%s' % (object.name or object.id)</field>
        <field name="paperformat_id" ref="paperformat_ktx3_carta"/>
    </record>

    <!-- 3) Plantilla QWeb con el diseño KTX 3 (premium). -->
    <!-- Carta = area de lineas amplia (min-height); Media Carta = compacta. -->
    <template id="report_ktx3_carta">
        <t t-call="web.html_container">
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <t t-foreach="docs" t-as="o">
                <t t-set="dte" t-value="o._ktx_fel_get_format_data()"/>
                <t t-set="cfg" t-value="o._ktx_fel_format_company_data()"/>
                <t t-set="qr_src" t-value="o._ktx_fel_format_qr_img_src(dte['qr_url'])"/>
                <t t-set="accent" t-value="cfg['accent_color'] or '#c0392b'"/>
                <t t-set="accent_text" t-value="cfg['accent_text'] or '#ffffff'"/>
                <t t-set="em" t-value="dte['emisor']"/>
                <t t-set="rc" t-value="dte['receptor']"/>
                <t t-set="cert" t-value="dte['certificacion']"/>

                <div class="ktx3">
                    <style>
                        .ktx3, .ktx3 * { font-family: Arial, Helvetica, sans-serif; box-sizing: border-box; }
                        .ktx3 { color:#1f2328; padding:14mm 12mm; font-size:11px; }
                        .ktx3 table { border-collapse: collapse; width:100%; }
                        .ktx3 .muted { color:#5b6472; }
                        .ktx3 .label { color:#9aa2b1; font-weight:700; }
                        .ktx3 .num { }
                    </style>

                    <!-- HEADER -->
                    <table>
                        <tr>
                            <td style="vertical-align:top; width:58%;">
                                <img t-if="cfg['logo']" t-att-src="image_data_uri(cfg['logo'])"
                                     style="max-height:66px; max-width:210px; object-fit:contain;"/>
                                <div style="font-size:13px; font-weight:700; margin-top:8px;">
                                    <t t-esc="em['nombre'] or em['nombre_comercial']"/>
                                </div>
                                <div class="muted" style="font-size:10.5px; line-height:1.55; margin-top:4px;">
                                    NIT <t t-esc="em['nit']"/><br/>
                                    <t t-esc="em['direccion']"/>
                                    <t t-if="em['municipio']">, <t t-esc="em['municipio']"/></t>
                                    <t t-if="em['departamento']">, <t t-esc="em['departamento']"/></t>
                                    <br/>
                                    <t t-if="cfg['social_phone']"><t t-esc="cfg['social_phone']"/><br/></t>
                                    <t t-esc="cfg['social_email'] or em['correo']"/>
                                </div>
                            </td>
                            <td style="vertical-align:top; text-align:right;">
                                <div class="label" style="font-size:9px; letter-spacing:2.2px;">DOCUMENTO TRIBUTARIO ELECTRÓNICO</div>
                                <div t-attf-style="font-size:23px; font-weight:800; color:{{accent}}; margin-top:3px; line-height:1;">
                                    <t t-esc="dte['tipo_documento_label']"/>
                                </div>
                                <table style="width:auto; float:right; margin-top:14px; font-size:11px;">
                                    <tr><td class="label" style="padding:2px 14px 2px 0; text-align:right;">SERIE</td>
                                        <td style="font-weight:700; text-align:right;"><t t-esc="cert['serie']"/></td></tr>
                                    <tr><td class="label" style="padding:2px 14px 2px 0; text-align:right;">NÚMERO</td>
                                        <td style="font-weight:700; text-align:right;"><t t-esc="cert['numero']"/></td></tr>
                                    <tr><td class="label" style="padding:2px 14px 2px 0; text-align:right;">MONEDA</td>
                                        <td style="font-weight:700; text-align:right;"><t t-esc="dte['moneda']"/></td></tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <div t-attf-style="height:3px; background:{{accent}}; margin:16px 0 0;"></div>

                    <!-- META GRID -->
                    <table style="border:1px solid #e5e8ee; border-top:none;">
                        <tr>
                            <td style="width:50%; padding:14px 18px; border-right:1px solid #e5e8ee; vertical-align:top;">
                                <div class="label" style="font-size:9px; letter-spacing:1.8px; margin-bottom:6px;">FACTURADO A</div>
                                <div style="font-size:12.5px; font-weight:700;"><t t-esc="rc['nombre']"/></div>
                                <div class="muted" style="font-size:10.5px; margin-top:4px; line-height:1.6;">
                                    NIT <t t-esc="rc['id']"/><br/>
                                    <t t-esc="rc['direccion'] or 'Ciudad'"/>
                                    <t t-if="rc['municipio']">, <t t-esc="rc['municipio']"/></t>
                                </div>
                            </td>
                            <td style="width:50%; padding:14px 18px; vertical-align:top;">
                                <table style="font-size:10.5px;">
                                    <tr><td class="label" style="padding:3px 0;">No. Autorización</td>
                                        <td style="text-align:right; font-weight:600; word-break:break-all;"><t t-esc="cert['uuid']"/></td></tr>
                                    <tr><td class="label" style="padding:3px 0;">Fecha emisión</td>
                                        <td style="text-align:right; font-weight:600;"><t t-esc="dte['fecha_emision']"/></td></tr>
                                    <tr><td class="label" style="padding:3px 0;">Fecha certificación</td>
                                        <td style="text-align:right; font-weight:600;"><t t-esc="cert['fecha']"/></td></tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ITEMS -->
                    <!-- En Carta el area de lineas reserva ~150mm (amplia); en
                         Media Carta no reserva (compacta, solo las lineas). -->
                    <div t-attf-style="margin-top:16px; #{'min-height:80mm;' if cfg['paper_size'] == 'carta' else ''}">
                    <table style="font-size:11px;">
                        <thead>
                            <tr t-attf-style="background:{{accent}}; color:{{accent_text}};">
                                <th t-attf-style="text-align:center; padding:8px 10px; font-size:9.5px; letter-spacing:0.8px; width:52px; color:{{accent_text}};">CANT.</th>
                                <th t-attf-style="text-align:left; padding:8px 12px; font-size:9.5px; letter-spacing:0.8px; color:{{accent_text}};">DESCRIPCIÓN</th>
                                <th t-attf-style="text-align:right; padding:8px 12px; font-size:9.5px; letter-spacing:0.8px; width:100px; color:{{accent_text}};">P. UNIT.</th>
                                <th t-attf-style="text-align:right; padding:8px 14px; font-size:9.5px; letter-spacing:0.8px; width:110px; color:{{accent_text}};">VALOR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="dte['items']" t-as="it" style="border-bottom:1px solid #eef0f4; color:#1f2328;">
                                <td style="text-align:center; padding:10px; vertical-align:top; color:#1f2328;">
                                    <t t-esc="'%g' % it['cantidad']"/>
                                </td>
                                <td style="padding:10px 12px; vertical-align:top; line-height:1.5; color:#1f2328;">
                                    <span style="font-weight:700;"><t t-esc="it['descripcion']"/></span>
                                    <t t-if="it['unidad_medida']">
                                        <span style="color:#9aa2b1; font-size:9.5px;"> · <t t-esc="it['unidad_medida']"/></span>
                                    </t>
                                </td>
                                <td style="text-align:right; padding:10px 12px; vertical-align:top; color:#1f2328;">
                                    <t t-esc="'%.2f' % it['precio_unitario']"/>
                                </td>
                                <td style="text-align:right; padding:10px 14px; vertical-align:top; font-weight:600; color:#1f2328;">
                                    <t t-esc="'%.2f' % it['total']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>

                    <!-- BOTTOM -->
                    <table style="margin-top:20px;">
                        <tr>
                            <td style="width:56%; vertical-align:top; padding-right:26px;">
                                <div class="label" style="font-size:9px; letter-spacing:1.6px;">TOTAL EN LETRAS</div>
                                <div style="font-size:11.5px; font-weight:700; margin-top:3px;">
                                    <t t-esc="dte['total_en_letras']"/>
                                </div>

                                <div t-if="dte['frases']" style="margin-top:14px;">
                                    <t t-foreach="dte['frases']" t-as="fr">
                                        <span t-if="fr['texto']" t-attf-style="display:inline-block; font-size:9px; letter-spacing:0.4px; background:#f2f3f5; color:{{accent}}; font-weight:700; padding:5px 9px; border-radius:3px; margin:0 5px 5px 0;">
                                            <t t-esc="fr['texto']"/>
                                        </span>
                                    </t>
                                </div>

                                <div t-if="cfg['show_footer'] and cfg['footer_description']" class="muted"
                                     style="margin-top:14px; font-size:10px; line-height:1.55;">
                                    <t t-esc="cfg['footer_description']"/>
                                </div>
                            </td>
                            <td style="width:44%; vertical-align:top;">
                                <div style="border:1px solid #e5e8ee; border-radius:8px; overflow:hidden;">
                                    <table>
                                        <tr style="border-bottom:1px solid #eef0f4;">
                                            <td class="muted" style="padding:10px 16px; font-size:11.5px;">Subtotal</td>
                                            <td style="padding:10px 16px; font-size:11.5px; text-align:right; font-weight:600;">
                                                <t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % dte['gran_total']"/>
                                            </td>
                                        </tr>
                                        <tr t-foreach="dte['total_impuestos']" t-as="imp" style="border-bottom:1px solid #eef0f4;">
                                            <td class="muted" style="padding:10px 16px; font-size:11.5px;">
                                                <t t-esc="imp['nombre_corto']"/> (incluido)
                                            </td>
                                            <td style="padding:10px 16px; font-size:11.5px; text-align:right; font-weight:600;">
                                                <t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % imp['monto']"/>
                                            </td>
                                        </tr>
                                        <tr t-attf-style="background:{{accent}}; color:{{accent_text}};">
                                            <td t-attf-style="padding:13px 16px; font-size:10.5px; letter-spacing:1px; font-weight:700; color:{{accent_text}};">TOTAL A PAGAR</td>
                                            <td t-attf-style="padding:13px 16px; text-align:right; font-size:18px; font-weight:800; color:{{accent_text}};">
                                                <t t-esc="dte['moneda']"/> <t t-esc="'%.2f' % dte['gran_total']"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- FOOTER / CERTIFICACIÓN -->
                    <table style="margin-top:24px; border-top:1px solid #e5e8ee; padding-top:14px;">
                        <tr>
                            <td style="width:96px; vertical-align:top; padding-top:14px;">
                                <img t-if="qr_src" t-att-src="qr_src" style="width:84px; height:84px;"/>
                            </td>
                            <td style="vertical-align:top; padding:14px 0 0 16px;">
                                <div class="label" style="font-size:9px; letter-spacing:1.4px; margin-bottom:4px;">DATOS DE CERTIFICACIÓN</div>
                                <div class="muted" style="font-size:10px; line-height:1.65;">
                                    <span style="color:#1f2328; font-weight:700;">Certificador:</span>
                                    <t t-esc="cert['nombre_certificador']"/> · NIT <t t-esc="cert['nit_certificador']"/><br/>
                                    Autorización <t t-esc="cert['uuid']"/><br/>
                                    Certificado el <t t-esc="cert['fecha']"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>
