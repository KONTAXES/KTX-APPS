<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "Pagar con Caja Chica" button to vendor invoice/journal entry form -->
    <record id="view_account_move_inherit_petty_cash" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ktx.petty.cash</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <button name="action_add_to_petty_cash_staging"
                    string="Pagar con Caja Chica"
                    type="object"
                    class="btn-secondary"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'entry') or state != 'posted' or payment_state == 'paid'"
                    groups="ktx_petty_cash.group_petty_cash_user"/>
            </xpath>
        </field>
    </record>
</odoo>
