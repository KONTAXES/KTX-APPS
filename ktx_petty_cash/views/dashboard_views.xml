<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ktx_petty_cash_dashboard_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.dashboard.form</field>
        <field name="model">ktx.petty.cash.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tablero" create="false" edit="false" delete="false">
                <sheet>
                    <field name="company_currency_id" invisible="1"/>

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0" style="color:#2d3748;font-weight:700">
                            💼 Tablero de Caja Chica
                        </h2>
                        <button name="action_open_dashboard" type="object"
                            string="↺ Actualizar" class="btn btn-sm btn-outline-secondary"/>
                    </div>

                    <!-- KPI Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-4 col-lg">
                            <div class="card h-100 border-0 shadow-sm"
                                style="background:linear-gradient(135deg,#667eea,#764ba2)">
                                <div class="card-body text-white text-center p-3">
                                    <div style="font-size:2rem;font-weight:800;line-height:1">
                                        <field name="total_funds"/>
                                    </div>
                                    <div style="font-size:0.8rem;opacity:0.9;margin-top:4px">
                                        💼 Fondos Activos
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg">
                            <div class="card h-100 border-0 shadow-sm"
                                style="background:linear-gradient(135deg,#11998e,#38ef7d)">
                                <div class="card-body text-white text-center p-3">
                                    <div style="font-size:1.4rem;font-weight:800;line-height:1">
                                        <field name="total_balance" widget="monetary"
                                            options="{'currency_field':'company_currency_id'}"/>
                                    </div>
                                    <div style="font-size:0.8rem;opacity:0.9;margin-top:4px">
                                        💰 Saldo Total
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg">
                            <div class="card h-100 border-0 shadow-sm"
                                style="background:linear-gradient(135deg,#f6d365,#fda085)">
                                <div class="card-body text-white text-center p-3">
                                    <div style="font-size:2rem;font-weight:800;line-height:1">
                                        <field name="moves_pending"/>
                                    </div>
                                    <div style="font-size:0.8rem;opacity:0.9;margin-top:4px">
                                        ⏳ Gastos por Aprobar
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg">
                            <div class="card h-100 border-0 shadow-sm"
                                style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
                                <div class="card-body text-white text-center p-3">
                                    <div style="font-size:2rem;font-weight:800;line-height:1">
                                        <field name="replenishments_pending"/>
                                    </div>
                                    <div style="font-size:0.8rem;opacity:0.9;margin-top:4px">
                                        🔄 Reposiciones Pendientes
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg">
                            <div class="card h-100 border-0 shadow-sm"
                                style="background:linear-gradient(135deg,#e74a3b,#c0392b)">
                                <div class="card-body text-white text-center p-3">
                                    <div style="font-size:2rem;font-weight:800;line-height:1">
                                        <field name="funds_low_balance"/>
                                    </div>
                                    <div style="font-size:0.8rem;opacity:0.9;margin-top:4px">
                                        ⚠️ Fondos Saldo Bajo
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Monto gastado del mes -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm"
                                style="border-left:4px solid #f6c23e!important">
                                <div class="card-body p-3">
                                    <div class="text-muted"
                                        style="font-size:0.75rem;font-weight:600;text-transform:uppercase">
                                        Gasto Aprobado Este Mes
                                    </div>
                                    <div style="font-size:1.3rem;font-weight:700;color:#f6c23e;margin-top:4px">
                                        <field name="total_spent_month" widget="monetary"
                                            options="{'currency_field':'company_currency_id'}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm"
                                style="border-left:4px solid #858796!important">
                                <div class="card-body p-3">
                                    <div class="text-muted"
                                        style="font-size:0.75rem;font-weight:600;text-transform:uppercase">
                                        Accesos Rápidos
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap mt-2">
                                        <button name="%(action_ktx_petty_cash_fund)d"
                                            type="action" string="💼 Fondos"
                                            class="btn btn-sm btn-outline-primary"/>
                                        <button name="%(action_ktx_petty_cash_move_pending)d"
                                            type="action" string="⏳ Aprobar Gastos"
                                            class="btn btn-sm btn-outline-warning"/>
                                        <button name="%(action_ktx_petty_cash_replenishment)d"
                                            type="action" string="🔄 Reposiciones"
                                            class="btn btn-sm btn-outline-info"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-0 pb-0">
                                    <h6 class="mb-0" style="color:#4e73df;font-weight:700">
                                        💼 Estado de Fondos
                                    </h6>
                                    <small class="text-muted">Saldo actual vs. monto inicial</small>
                                </div>
                                <div class="card-body pt-2">
                                    <field name="top_funds_html" widget="html" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-0 pb-0">
                                    <h6 class="mb-0" style="color:#1cc88a;font-weight:700">
                                        🏪 Top Proveedores
                                    </h6>
                                    <small class="text-muted">Gasto total por proveedor</small>
                                </div>
                                <div class="card-body pt-2">
                                    <field name="expense_by_partner_html" widget="html" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-2">
                        <div class="card-header bg-white border-0 pb-0">
                            <h6 class="mb-0" style="color:#36b9cc;font-weight:700">
                                📈 Gasto Mensual — Últimos 12 Meses
                            </h6>
                            <small class="text-muted">Gastos aprobados y reembolsados</small>
                        </div>
                        <div class="card-body">
                            <field name="monthly_html" widget="html" readonly="1"/>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ktx_petty_cash_dashboard" model="ir.actions.server">
        <field name="name">Tablero Caja Chica</field>
        <field name="model_id" ref="model_ktx_petty_cash_dashboard"/>
        <field name="binding_model_id" ref="model_ktx_petty_cash_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env['ktx.petty.cash.dashboard'].action_open_dashboard()</field>
    </record>

</odoo>
