<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ktx_petty_cash_fund_replenishment_wizard_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.fund.replenishment.wizard.form</field>
        <field name="model">ktx.petty.cash.fund.replenishment.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Fondos">
                <sheet>
                    <div class="oe_title"><h2>Agregar Fondos a la Caja Chica</h2></div>
                    <group>
                        <group string="Fondo">
                            <field name="fund_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fund_balance" string="Saldo Actual"/>
                            <field name="date" string="Fecha de Pago"/>
                        </group>
                        <group string="Pago">
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="memo"
                                placeholder="Descripción del pago…"/>
                            <field name="payment_ref"
                                placeholder="N° cheque, ref. transferencia…"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Registrar Pago"
                        type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
