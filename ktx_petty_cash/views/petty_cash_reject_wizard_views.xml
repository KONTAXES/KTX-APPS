<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ktx_petty_cash_reject_wizard_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.reject.wizard.form</field>
        <field name="model">ktx.petty.cash.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Gasto">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="rejection_note" placeholder="Indique el motivo del rechazo..." required="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Rechazar" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
