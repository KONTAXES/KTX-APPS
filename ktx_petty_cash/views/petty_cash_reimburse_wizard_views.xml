<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ktx_petty_cash_reimburse_wizard_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.reimburse.wizard.form</field>
        <field name="model">ktx.petty.cash.reimburse.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Pago">
                <group>
                    <group string="Información">
                        <field name="move_id" readonly="1"/>
                        <field name="fund_name" readonly="1" string="Fondo"/>
                        <field name="partner_name" readonly="1" string="Proveedor"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group string="Pago">
                        <field name="payment_date"/>
                        <field name="payment_method"/>
                        <field name="payment_ref"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmar Pago" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
