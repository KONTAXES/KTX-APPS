<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── LIST ─── -->
    <record id="view_ktx_petty_cash_staging_list" model="ir.ui.view">
        <field name="name">ktx.petty.cash.staging.list</field>
        <field name="model">ktx.petty.cash.staging</field>
        <field name="arch" type="xml">
            <list string="Gastos por Reembolsar">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="move_name"/>
                <field name="ref" optional="hide"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_pending" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'assigned'"
                    decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- ─── FORM ─── -->
    <record id="view_ktx_petty_cash_staging_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.staging.form</field>
        <field name="model">ktx.petty.cash.staging</field>
        <field name="arch" type="xml">
            <form string="Gasto por Reembolsar">
                <header>
                    <button name="action_assign_petty_cash" string="Asignar a Caja Chica"
                        type="object" class="btn-primary"
                        invisible="state == 'assigned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,assigned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_open_source_move" icon="fa-file-text-o">
                            <span class="o_stat_text">Ver Factura</span>
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="action_open_petty_cash_move" icon="fa-money"
                            invisible="not petty_cash_move_id">
                            <span class="o_stat_text">Movimiento CC</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="move_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Documento">
                            <field name="move_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="ref" readonly="1"/>
                        </group>
                        <group string="Montos">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_pending" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Asignación">
                            <field name="petty_cash_move_id" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── SEARCH ─── -->
    <record id="view_ktx_petty_cash_staging_search" model="ir.ui.view">
        <field name="name">ktx.petty.cash.staging.search</field>
        <field name="model">ktx.petty.cash.staging</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_name"/>
                <field name="ref"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="assigned" string="Asignados" domain="[('state', '=', 'assigned')]"/>
                <separator/>
                <filter name="by_company" string="Por Compañía"
                        groups="base.group_multi_company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- ─── ACTION ─── -->
    <record id="action_ktx_petty_cash_staging" model="ir.actions.act_window">
        <field name="name">Gastos por Reembolsar</field>
        <field name="res_model">ktx.petty.cash.staging</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ktx_petty_cash_staging_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay gastos por reembolsar.</p>
            <p>Agrega facturas desde el menú de Facturas de Proveedor.</p>
        </field>
    </record>

    <!-- ─── SERVER ACTION on ktx.petty.cash.staging (bulk assign) ─── -->
    <record id="action_ktx_petty_cash_staging_assign" model="ir.actions.server">
        <field name="name">Asignar a Caja Chica</field>
        <field name="model_id" ref="ktx_petty_cash.model_ktx_petty_cash_staging"/>
        <field name="binding_model_id" ref="ktx_petty_cash.model_ktx_petty_cash_staging"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_assign_petty_cash()</field>
    </record>

    <!-- ─── SERVER ACTION on account.move (list selection) ─── -->
    <record id="action_account_move_add_to_staging" model="ir.actions.server">
        <field name="name">Pagar con Caja Chica</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
added = []
already = []
skipped = []
for record in records:
    if record.state != 'posted' or record.payment_state == 'paid' or record.move_type not in ('in_invoice', 'in_receipt', 'entry'):
        skipped.append(record.name)
        continue
    existing = env['ktx.petty.cash.staging'].search([('move_id', '=', record.id)], limit=1)
    if existing:
        already.append(record.name)
        continue
    env['ktx.petty.cash.staging'].create({'move_id': record.id})
    added.append(record.name)

parts = []
if added:
    parts.append('%d agregado(s): %s.' % (len(added), ', '.join(added)))
if already:
    parts.append('Ya existía(n): %s.' % ', '.join(already))
if skipped:
    parts.append('%d omitido(s).' % len(skipped))
msg = ' '.join(parts) or 'Sin cambios.'
notif_type = 'success' if added else ('warning' if already else 'danger')
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Pagar con Caja Chica',
        'message': msg,
        'type': notif_type,
        'sticky': False,
    },
}
        </field>
    </record>

</odoo>
