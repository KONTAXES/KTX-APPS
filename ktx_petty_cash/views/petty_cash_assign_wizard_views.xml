<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ktx_petty_cash_assign_wizard_form" model="ir.ui.view">
        <field name="name">ktx.petty.cash.assign.wizard.form</field>
        <field name="model">ktx.petty.cash.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar a Caja Chica">
                <sheet>
                    <div class="oe_title">
                        <h2>Asignar Gastos a Fondo de Caja Chica</h2>
                    </div>
                    <group>
                        <group string="Fondo de Destino">
                            <field name="fund_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fund_balance"/>
                            <field name="payment_date"/>
                        </group>
                        <group string="Resumen">
                            <field name="items_count" string="Documentos Seleccionados"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <field name="staging_ids" readonly="1">
                        <list>
                            <field name="move_name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_pending" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_assign" string="Crear Movimientos de Caja Chica" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
