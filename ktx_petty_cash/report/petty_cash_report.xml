<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_ktx_petty_cash_replenishment" model="ir.actions.report">
        <field name="name">Reposición de Caja Chica</field>
        <field name="model">ktx.petty.cash.replenishment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_petty_cash.report_petty_cash_replenishment</field>
        <field name="report_file">ktx_petty_cash.report_petty_cash_replenishment</field>
        <field name="binding_model_id" ref="model_ktx_petty_cash_replenishment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_petty_cash_replenishment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Reposición de Caja Chica</h2>
                                <h3 class="text-muted"><t t-esc="o.name"/></h3>
                            </div>
                            <div class="col-6 text-end">
                                <table class="table table-sm table-borderless">
                                    <tr><th>Fecha:</th><td><t t-esc="o.date" t-options="{'widget':'date'}"/></td></tr>
                                    <tr><th>Fondo:</th><td><t t-esc="o.fund_id.name"/></td></tr>
                                    <tr><th>Custodio:</th><td><t t-esc="o.fund_id.custodian_id.name or ''"/></td></tr>
                                    <tr><th>Estado:</th><td><t t-esc="o.state"/></td></tr>
                                </table>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha</th><th>Descripción</th>
                                    <th>Proveedor</th><th>Referencia</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.date" t-options="{'widget':'date'}"/></td>
                                        <td><t t-esc="line.name or ''"/></td>
                                        <td><t t-esc="line.partner_id.name or ''"/></td>
                                        <td><t t-esc="line.ref or ''"/></td>
                                        <td class="text-end">
                                            <t t-esc="line.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">Total:</td>
                                    <td class="text-end">
                                        <t t-esc="o.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000;padding-top:6px;">
                                    Custodio<br/><small><t t-esc="o.fund_id.custodian_id.name or ''"/></small>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000;padding-top:6px;">
                                    Aprobado por<br/><small>&#160;</small>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000;padding-top:6px;">
                                    Contabilidad<br/><small>&#160;</small>
                                </div>
                            </div>
                        </div>
                        <t t-if="o.notes">
                            <div class="mt-3"><strong>Notas:</strong> <t t-esc="o.notes"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_ktx_petty_cash_fund" model="ir.actions.report">
        <field name="name">Estado del Fondo</field>
        <field name="model">ktx.petty.cash.fund</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_petty_cash.report_petty_cash_fund</field>
        <field name="report_file">ktx_petty_cash.report_petty_cash_fund</field>
        <field name="binding_model_id" ref="model_ktx_petty_cash_fund"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_petty_cash_fund">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Estado del Fondo de Caja Chica</h2>
                                <h3 class="text-muted"><t t-esc="o.name"/></h3>
                            </div>
                            <div class="col-6 text-end">
                                <table class="table table-sm table-borderless">
                                    <tr><th>Custodio:</th><td><t t-esc="o.custodian_id.name or ''"/></td></tr>
                                    <tr><th>Estado:</th><td><t t-esc="o.state"/></td></tr>
                                    <tr><th>Monto Inicial:</th><td>
                                        <t t-esc="o.initial_amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td></tr>
                                    <tr><th>Saldo Actual:</th><td class="fw-bold">
                                        <t t-esc="o.current_balance" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td></tr>
                                </table>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha</th><th>Tipo</th><th>Descripción</th>
                                    <th>Proveedor</th><th>Referencia</th>
                                    <th>Estado</th><th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.date" t-options="{'widget':'date'}"/></td>
                                        <td><t t-esc="line.move_type"/></td>
                                        <td><t t-esc="line.name or ''"/></td>
                                        <td><t t-esc="line.partner_id.name or ''"/></td>
                                        <td><t t-esc="line.ref or ''"/></td>
                                        <td><t t-esc="line.state"/></td>
                                        <td class="text-end">
                                            <t t-esc="line.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>


    <!-- ─── Fund State PDF Report ─── -->
    <record id="action_report_ktx_petty_cash_fund_state" model="ir.actions.report">
        <field name="name">Imprimir Reporte PDF</field>
        <field name="model">ktx.petty.cash.fund</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ktx_petty_cash.report_petty_cash_fund_state</field>
        <field name="report_file">ktx_petty_cash.report_petty_cash_fund_state</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_petty_cash_fund_state">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div style="background:#1e3a5f;color:white;padding:16px 20px;border-radius:6px;margin-bottom:20px">
                            <h2 style="margin:0;color:white">Estado de Caja Chica</h2>
                            <p style="margin:4px 0 0;opacity:0.85;font-size:13px">
                                <t t-out="o.name"/>
                                <span style="margin-left:12px;font-size:11px;opacity:0.7">
                                    Período: <t t-out="o.date_start or ''"/> — <t t-out="o.date_end or ''"/>
                                </span>
                            </p>
                        </div>

                        <!-- Fund summary cards -->
                        <div style="display:flex;gap:12px;margin-bottom:20px">
                            <div style="flex:1;background:#f0f9ff;border:1px solid #bae6fd;border-radius:6px;padding:12px;text-align:center">
                                <div style="font-size:11px;color:#0369a1;font-weight:600;text-transform:uppercase">Saldo Inicial</div>
                                <div style="font-size:18px;font-weight:700;color:#0c4a6e">
                                    <t t-out="o.currency_id.symbol"/> <t t-out="'%.2f' % o.initial_amount"/>
                                </div>
                            </div>
                            <div style="flex:1;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:12px;text-align:center">
                                <div style="font-size:11px;color:#166534;font-weight:600;text-transform:uppercase">Saldo Actual</div>
                                <div style="font-size:18px;font-weight:700;color:#14532d">
                                    <t t-out="o.currency_id.symbol"/> <t t-out="'%.2f' % o.current_balance"/>
                                </div>
                            </div>
                            <div style="flex:1;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:12px;text-align:center">
                                <div style="font-size:11px;color:#991b1b;font-weight:600;text-transform:uppercase">Total Gastado</div>
                                <div style="font-size:18px;font-weight:700;color:#7f1d1d">
                                    <t t-out="o.currency_id.symbol"/> <t t-out="'%.2f' % o.total_spent"/>
                                </div>
                            </div>
                            <div style="flex:1;background:#faf5ff;border:1px solid #e9d5ff;border-radius:6px;padding:12px;text-align:center">
                                <div style="font-size:11px;color:#6b21a8;font-weight:600;text-transform:uppercase">Total Repuesto</div>
                                <div style="font-size:18px;font-weight:700;color:#581c87">
                                    <t t-out="o.currency_id.symbol"/> <t t-out="'%.2f' % o.total_replenished"/>
                                </div>
                            </div>
                        </div>

                        <!-- Fund info -->
                        <table style="width:100%;border-collapse:collapse;margin-bottom:20px;font-size:12px">
                            <tr style="background:#f8fafc">
                                <td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:600;width:25%">Custodio</td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0"><t t-out="o.custodian_id.name or '-'"/></td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:600;width:25%">Autorizador</td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0"><t t-out="o.authorizer_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:600">Cuenta del Fondo</td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0"><t t-out="o.account_id.display_name or '-'"/></td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:600">Estado</td>
                                <td style="padding:6px 10px;border:1px solid #e2e8f0">
                                    <span t-if="o.state == 'open'" style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:10px;font-size:11px">Abierto</span>
                                    <span t-else="" style="background:#f1f5f9;color:#475569;padding:2px 8px;border-radius:10px;font-size:11px">Cerrado</span>
                                </td>
                            </tr>
                        </table>

                        <!-- Movements table -->
                        <h3 style="color:#1e3a5f;border-bottom:2px solid #1e3a5f;padding-bottom:4px;margin-bottom:10px">Movimientos</h3>
                        <table style="width:100%;border-collapse:collapse;font-size:11px">
                            <thead>
                                <tr style="background:#1e3a5f;color:white">
                                    <th style="padding:7px 8px;text-align:left">Fecha</th>
                                    <th style="padding:7px 8px;text-align:left">Descripción</th>
                                    <th style="padding:7px 8px;text-align:left">Proveedor</th>
                                    <th style="padding:7px 8px;text-align:left">Tipo</th>
                                    <th style="padding:7px 8px;text-align:right">Débito</th>
                                    <th style="padding:7px 8px;text-align:right">Crédito</th>
                                    <th style="padding:7px 8px;text-align:right">Saldo</th>
                                    <th style="padding:7px 8px;text-align:center">Estado</th>
                                    <th style="padding:7px 8px;text-align:left">Autorizado por</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids.sorted(key=lambda m: (m.date, m.id))" t-as="line">
                                    <tr t-attf-style="background:{{ '#f0fdf4' if line.state == 'reimbursed' else ('#fffbeb' if line.state == 'approved' else ('#fef2f2' if line.state in ('rejected','cancelled') else 'white')) }}">
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0">
                                            <t t-out="line.payment_date or line.date"/>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0">
                                            <t t-out="line.name or ''"/>
                                            <t t-if="line.ref"><br/><span style="color:#6b7280;font-size:10px"><t t-out="line.ref"/></span></t>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0"><t t-out="line.partner_id.name or ''"/></td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0"><t t-out="dict(line._fields['move_type'].selection).get(line.move_type, line.move_type)"/></td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0;text-align:right;color:#dc2626">
                                            <t t-if="line.debit"><t t-out="'%.2f' % line.debit"/></t>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0;text-align:right;color:#16a34a">
                                            <t t-if="line.credit"><t t-out="'%.2f' % line.credit"/></t>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:600">
                                            <t t-out="'%.2f' % line.balance_after"/>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0;text-align:center">
                                            <t t-out="dict(line._fields['state'].selection).get(line.state, line.state)"/>
                                        </td>
                                        <td style="padding:5px 8px;border-bottom:1px solid #e2e8f0">
                                            <t t-out="line.write_uid.name or ''"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Signature section -->
                        <div style="margin-top:40px;display:flex;gap:40px">
                            <div style="flex:1;text-align:center">
                                <div style="border-top:1px solid #374151;padding-top:6px;font-size:11px;color:#374151">
                                    <strong><t t-out="o.custodian_id.name or 'Custodio'"/></strong><br/>Custodio del Fondo
                                </div>
                            </div>
                            <div style="flex:1;text-align:center">
                                <div style="border-top:1px solid #374151;padding-top:6px;font-size:11px;color:#374151">
                                    <strong><t t-out="o.authorizer_id.name or 'Autorizador'"/></strong><br/>Autorizador
                                </div>
                            </div>
                            <div style="flex:1;text-align:center">
                                <div style="border-top:1px solid #374151;padding-top:6px;font-size:11px;color:#374151">
                                    <strong>Administrador</strong><br/>Contabilidad
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
