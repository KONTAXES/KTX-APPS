<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Oficio horizontal para la planilla de sueldos (formato libro de salarios) -->
    <record id="paperformat_planilla_legal" model="report.paperformat">
        <field name="name">KTX Planilla Oficio Horizontal</field>
        <field name="format">custom</field>
        <field name="page_height">216</field>
        <field name="page_width">330</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Carta para recibos de nómina y finiquitos -->
    <record id="paperformat_recibo_carta" model="report.paperformat">
        <field name="name">KTX Recibo de Nómina Carta</field>
        <field name="format">custom</field>
        <field name="page_height">279</field>
        <field name="page_width">216</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

</odoo>
