<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asistencia_masiva_form" model="ir.ui.view">
        <field name="name">ktx.planilla.asistencia.masiva.form</field>
        <field name="model">ktx.planilla.asistencia.masiva</field>
        <field name="arch" type="xml">
            <form string="Captura Masiva de Asistencias">
                <group>
                    <group string="Rango y Tipo">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="tipo"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Horario y Días">
                        <field name="usar_horario_empleado"
                               invisible="tipo != 'asistencia'"/>
                        <field name="hora_entrada" widget="float_time"
                               invisible="tipo != 'asistencia' or usar_horario_empleado"/>
                        <field name="hora_salida" widget="float_time"
                               invisible="tipo != 'asistencia' or usar_horario_empleado"/>
                        <field name="incluir_sabados"/>
                        <field name="incluir_domingos"/>
                        <field name="sobrescribir"/>
                    </group>
                </group>
                <group string="Empleados">
                    <field name="employee_ids" nolabel="1" colspan="2"
                           widget="many2many_tags_avatar"/>
                </group>
                <group>
                    <field name="motivo" placeholder="Motivo u observaciones (opcional)…"/>
                </group>
                <footer>
                    <button name="action_generar" string="Generar Registros"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asistencia_masiva" model="ir.actions.act_window">
        <field name="name">Captura Masiva de Asistencias</field>
        <field name="res_model">ktx.planilla.asistencia.masiva</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
