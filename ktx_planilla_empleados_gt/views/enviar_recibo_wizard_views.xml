<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_enviar_recibo_wizard_form" model="ir.ui.view">
        <field name="name">ktx.planilla.enviar.recibo.wizard.form</field>
        <field name="model">ktx.planilla.enviar.recibo.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Recibo">
                <group>
                    <group>
                        <field name="linea_id" invisible="1"/>
                        <field name="liquidacion_id" invisible="1"/>
                        <field name="sign_disponible" invisible="1"/>
                        <field name="employee_id" readonly="1"
                               widget="many2one_avatar_employee"/>
                        <field name="modo" widget="radio"/>
                        <field name="canal" widget="radio"/>
                    </group>
                    <group>
                        <field name="email" invisible="canal != 'email'"
                               required="canal == 'email'"/>
                        <field name="telefono" invisible="canal != 'whatsapp'"
                               required="canal == 'whatsapp'"/>
                        <field name="firma_link" invisible="not firma_link"
                               widget="CopyClipboardChar"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="modo != 'firma_link' or sign_disponible">
                    El módulo de Firmas (sign) no está instalado. Instálelo para
                    generar el link de firma electrónica con validez legal
                    (Decreto 47-2008), o envíe el documento en PDF.
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="modo != 'firma_link' or not sign_disponible">
                    Se generará un <b>link de firma</b>: el empleado abre el
                    documento en Odoo, lo firma electrónicamente y descarga su
                    copia. El documento firmado queda guardado en
                    <b>Firmas → Documentos</b> con la cláusula de aceptación
                    del pago. El link también queda registrado en el chatter.
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="modo != 'pdf'">
                    Se enviará el documento en PDF con la cláusula de
                    aceptación, para firma manuscrita de recibido.
                </div>
                <group string="Mensaje">
                    <field name="mensaje" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_enviar" string="Enviar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
