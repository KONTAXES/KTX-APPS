<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_ktx_check" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.ktx.check</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <!-- Solo el selector de formato — las posiciones van en Configuración de Cheques -->
                <field name="ktx_check_bank_format"
                       invisible="type != 'bank'"
                       string="Formato de Cheque KTX"/>
            </xpath>
        </field>
    </record>

</odoo>
