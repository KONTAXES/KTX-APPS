<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OWL chat client action -->
    <record id="action_claude_chat" model="ir.actions.client">
        <field name="name">Chat con Claude</field>
        <field name="tag">ktx_claude_ai.chat</field>
    </record>

    <menuitem id="menu_claude_root" name="Claude AI"
              web_icon="ktx_claude_ai,static/description/icon.png"
              sequence="50"
              groups="group_claude_user"/>

    <menuitem id="menu_claude_chat" name="Chat"
              parent="menu_claude_root"
              action="action_claude_chat"
              sequence="10"
              groups="group_claude_user"/>

    <menuitem id="menu_claude_my_connector" name="Mi conector de Claude.ai"
              parent="menu_claude_root"
              action="action_my_claude_connector"
              sequence="15"
              groups="group_claude_user"/>

    <menuitem id="menu_claude_conversations" name="Conversaciones"
              parent="menu_claude_root"
              action="action_claude_conversation"
              sequence="20"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_config" name="Configuración"
              parent="menu_claude_root"
              sequence="90"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_models" name="Modelos habilitados"
              parent="menu_claude_config"
              action="action_claude_enabled_model"
              sequence="10"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_models_wizard" name="Habilitar varios modelos"
              parent="menu_claude_config"
              action="action_claude_model_selection_wizard"
              sequence="15"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_logs" name="Bitácora"
              parent="menu_claude_config"
              action="action_claude_request_log"
              sequence="20"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_settings" name="Ajustes"
              parent="menu_claude_config"
              action="action_claude_config_settings"
              sequence="30"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_connector" name="Conector remoto"
              parent="menu_claude_config"
              sequence="40"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_connector_tokens" name="Tokens del conector"
              parent="menu_claude_connector"
              action="action_claude_connector_token"
              sequence="10"
              groups="group_claude_admin"/>

    <menuitem id="menu_claude_oauth_tokens" name="Tokens OAuth"
              parent="menu_claude_connector"
              action="action_claude_oauth_token"
              sequence="30"
              groups="group_claude_admin"/>
</odoo>
