<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_claude_user" model="res.groups">
            <field name="name">Claude AI / Usuario</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_claude_admin" model="res.groups">
            <field name="name">Claude AI / Administrador</field>
            <field name="implied_ids" eval="[(4, ref('group_claude_user'))]"/>
        </record>

        <!-- Privacy: every chat is strictly per-user. Each user (admins included)
             sees ONLY their own conversations and messages — what one user says
             to Claude is never visible to anyone else. -->
        <record id="rule_claude_conversation_own" model="ir.rule">
            <field name="name">Conversaciones propias</field>
            <field name="model_id" ref="model_claude_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_claude_user'))]"/>
        </record>
        <record id="rule_claude_message_own" model="ir.rule">
            <field name="name">Mensajes de conversaciones propias</field>
            <field name="model_id" ref="model_claude_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_claude_user'))]"/>
        </record>

        <!-- Personal OAuth clients: every user (including admins) sees ONLY
             their own client. The client_id is a credential — exposing other
             users' client_ids via the admin list is a privacy leak. Admins
             who need to revoke a specific user's client can do so through
             Odoo's ir.rule management or via the ORM shell. -->
        <record id="rule_claude_oauth_client_own" model="ir.rule">
            <field name="name">Cliente OAuth: cada usuario ve solo el suyo</field>
            <field name="model_id" ref="model_claude_oauth_client"/>
            <field name="domain_force">[('user_id', 'in', [user.id, False])]</field>
            <field name="groups" eval="[(4, ref('group_claude_user'))]"/>
        </record>

        <!-- Audit log: a user sees their own entries; admins see all. -->
        <record id="rule_claude_log_own" model="ir.rule">
            <field name="name">Bitácora propia</field>
            <field name="model_id" ref="model_claude_request_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_claude_user'))]"/>
        </record>
        <record id="rule_claude_log_admin" model="ir.rule">
            <field name="name">Bitácora: administradores ven todo</field>
            <field name="model_id" ref="model_claude_request_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_claude_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_claude_admin'))]"/>
        </record>
    </data>
</odoo>
