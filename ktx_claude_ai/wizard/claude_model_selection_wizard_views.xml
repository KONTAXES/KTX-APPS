<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claude_model_selection_wizard_form" model="ir.ui.view">
        <field name="name">claude.model.selection.wizard.form</field>
        <field name="model">claude.model.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Habilitar modelos para Claude">
                <group>
                    <field name="model_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <group string="Operaciones permitidas">
                    <field name="allow_read"/>
                    <field name="allow_create"/>
                    <field name="allow_write"/>
                    <field name="allow_unlink"/>
                    <field name="allow_action"/>
                </group>
                <footer>
                    <button string="Habilitar" name="action_enable" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_claude_model_selection_wizard" model="ir.actions.act_window">
        <field name="name">Habilitar modelos</field>
        <field name="res_model">claude.model.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
