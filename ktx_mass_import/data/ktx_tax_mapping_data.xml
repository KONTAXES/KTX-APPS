        <!-- ======= TASA MUNICIPAL =======
             El CodigoUnidadGravable de TASA MUNICIPAL es un codigo de municipio
             de 7 digitos (DDMM000) con cientos de valores posibles.
             Se usa UG=0 como comodin: si no hay entrada especifica para el codigo
             exacto del municipio, el modulo busca este registro como fallback.
             El usuario configura aqui el impuesto Odoo que representa la Tasa Municipal
             y se aplica a cualquier factura que traiga TASA MUNICIPAL en el XML FEL.
        -->
        <record id="tax_map_tasa_mun_0" model="ktx.tax.mapping">
            <field name="nombre_corto">TASA MUNICIPAL</field><field name="codigo_unidad_gravable">0</field>
            <field name="descripcion">Tasa Municipal (todos los municipios)</field>
