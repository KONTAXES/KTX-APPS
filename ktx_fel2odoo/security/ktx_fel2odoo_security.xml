<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Reglas de registro multiempresa: cada usuario solo ve y opera las
      conexiones, bitacoras y reglas de la(s) empresa(s) seleccionada(s) en el
      conmutador de companias. Asi, en "Conexiones FEL" y "Bitacora" no
      aparecen registros de otras empresas, y la sincronizacion actua solo
      sobre la conexion/empresa correspondiente.
    -->
    <data noupdate="0">

        <record id="ktx_fel2odoo_config_company_rule" model="ir.rule">
            <field name="name">FEL2Odoo: conexion por empresa</field>
            <field name="model_id" ref="model_ktx_fel2odoo_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="ktx_fel2odoo_log_company_rule" model="ir.rule">
            <field name="name">FEL2Odoo: bitacora por empresa</field>
            <field name="model_id" ref="model_ktx_fel2odoo_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="ktx_fel2odoo_account_rule_company_rule" model="ir.rule">
            <field name="name">FEL2Odoo: reglas de cuenta por empresa</field>
            <field name="model_id" ref="model_ktx_fel2odoo_account_rule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
