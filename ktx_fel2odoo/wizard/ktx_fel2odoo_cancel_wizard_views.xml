<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ktx_fel2odoo_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">ktx.fel2odoo.cancel.wizard.form</field>
        <field name="model">ktx.fel2odoo.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular factura ante la SAT">
                <field name="move_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Esta accion anula el documento <b><field name="fel2odoo_uuid" readonly="1" nolabel="1" class="d-inline"/></b>
                    ante la SAT. Es una operacion legal y no se puede deshacer desde Odoo.
                </div>
                <group>
                    <field name="motivo" placeholder="Motivo de la anulacion (opcional; si se deja vacio se usa 'Anular documento')"/>
                </group>
                <footer>
                    <button string="Anular ante la SAT" name="action_confirm" type="object"
                            class="btn-danger"
                            confirm="¿Confirma que desea anular este documento ante la SAT? Esta accion no se puede deshacer."/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
