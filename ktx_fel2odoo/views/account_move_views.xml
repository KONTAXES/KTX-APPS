<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ktx_fel2odoo_account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.ktx.fel2odoo</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <field name="fel2odoo_journal_enabled" invisible="1"/>
                <button name="action_fel2odoo_emitir" type="object"
                        string="Emitir ante la SAT (FEL2Odoo)"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="not fel2odoo_journal_enabled or move_type != 'out_invoice' or state != 'posted' or fel2odoo_state == 'emitido'"
                        confirm="Esto CERTIFICA esta factura ante la SAT como un documento legal real. ¿Confirma que desea emitirla?"/>
                <button name="action_fel2odoo_anular_wizard" type="object"
                        string="Anular ante la SAT (FEL2Odoo)"
                        class="btn-secondary"
                        groups="account.group_account_manager"
                        invisible="not fel2odoo_journal_enabled or fel2odoo_state != 'emitido'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Emitido (SAT)" bg_color="text-bg-success"
                        invisible="fel2odoo_state != 'emitido'"/>
                <widget name="web_ribbon" title="Anulado (SAT)" bg_color="text-bg-danger"
                        invisible="fel2odoo_state != 'anulado'"/>
                <group col="4" colspan="4" id="ktx_fel2odoo_group"
                       invisible="fel2odoo_state == 'none'">
                    <field name="fel2odoo_state" readonly="1"/>
                    <field name="fel2odoo_uuid" readonly="1"/>
                    <field name="fel2odoo_serie" readonly="1"/>
                    <field name="fel2odoo_numero" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
